<?xml version="1.0" encoding="UTF-8"?>
<!--
  ANE mutable-weight entitlements needed by the swap harness.
  These are Apple-private entitlements. A self-signed binary carrying them is
  honored ONLY under SIP off + amfi_get_out_of_my_way=1 (a research environment).
  On a stock Mac these are not grantable and the harness will no-op.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.aned.private.allow</key>
    <true/>
    <key>com.apple.aned.private.adapterWeight.allow</key>
    <true/>
    <key>com.apple.aned.private.mappingMutableWeightsBuffer.allow</key>
    <true/>
    <key>com.apple.private.iokit-user-access</key>
    <true/>
</dict>
</plist>
